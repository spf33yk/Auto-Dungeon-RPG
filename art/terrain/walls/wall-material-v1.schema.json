{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wall-material/v1 build input",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "themes",
    "source",
    "tileSize",
    "rise",
    "cap",
    "front",
    "capGain",
    "frontGain",
    "bevelGain",
    "light",
    "entranceMode"
  ],
  "properties": {
    "format": {
      "const": "wall-material"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "tileSize": {
      "const": 32
    },
    "rise": {
      "const": 0.75
    },
    "cap": {
      "const": [
        0,
        0,
        32,
        32
      ]
    },
    "front": {
      "const": [
        32,
        0,
        32,
        32
      ]
    },
    "light": {
      "const": "north-west"
    },
    "entranceMode": {
      "const": "integrated"
    },
    "capGain": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2
    },
    "frontGain": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2
    },
    "bevelGain": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2
    }
  }
}
