{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entrance-parts/v1",
  "type": "object",
  "required": ["format", "version", "id", "themes", "image", "tileSize", "width", "height", "parts"],
  "properties": {
    "format": {"const": "entrance-parts"},
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "themes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "image": {"type": "string", "minLength": 1},
    "tileSize": {"const": 32},
    "width": {"type": "integer", "minimum": 32},
    "height": {"type": "integer", "minimum": 32},
    "parts": {
      "type": "object",
      "required": ["leftJamb", "rightJamb", "lintel", "threshold"],
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"const": 32}, {"const": 32}]}}
    }
  }
}
